generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id         String    @id @default(cuid())
  publicKey  String    @unique
  name       String
  kind       String    @default("ios") // 'ios' | 'mac'
  shortCode  String?   @unique // Permanent 6-char pairing code for Macs (lazy-generated)
  seq        Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  /// Last time this device successfully authenticated (HTTP middleware
  /// or socket handshake). Used by `notifyLinkedIPhones` to filter out
  /// stale devices whose JWT has expired but whose APNs token is still
  /// technically valid — without this the server keeps pushing to dead
  /// installs forever.
  lastSeenAt DateTime?

  // Notification preferences (only meaningful for iOS devices).
  // `notificationsEnabled` is the master kill-switch — when false, the server
  // skips ALL push delivery for this device regardless of the per-kind flags
  // below. Existing devices default to true so the upgrade is silent.
  notificationsEnabled Boolean @default(true)
  notifyOnCompletion   Boolean @default(false) // non-ended → ended
  notifyOnApproval     Boolean @default(false) // tool waiting_approval
  notifyOnError        Boolean @default(false) // tool status=error

  // Subscription / trial fields. Mac devices ignore these (server skips
  // enforcement for kind='mac'); iOS devices start at 'none', flip to
  // 'trial' after first pairing, and 'active' after a verified IAP.
  subscriptionStatus    String    @default("none")
  trialStartedAt        DateTime?
  trialExpiresAt        DateTime?
  trialExpireNotifiedAt DateTime?

  sessions      Session[]
  pushTokens    PushToken[]
  launchPresets LaunchPreset[]
  knownProjects KnownProject[]

  // Device linking (paired devices can see each other's sessions)
  linksAsSource DeviceLink[] @relation("LinkSource")
  linksAsTarget DeviceLink[] @relation("LinkTarget")

  // Slice 7: bind to a User. Nullable for legacy chat-side rows pre-Slice-7
  // (seed boot fills these in for the dogfood user). Hijack guard in /v1/auth.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // R2.3: bridge from the monitoring universe (Device/DeviceLink) to the workspace
  // universe (ControlMachine). When a Mac that already enrolled a workspace later
  // attaches MioIsland monitoring, the monitor Device links to its existing
  // ControlMachine here — so NO new workspace opens. Null for phones / unbridged Macs.
  controlMachineId String?         @map("control_machine_id") @db.Uuid
  controlMachine   ControlMachine? @relation(fields: [controlMachineId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([controlMachineId])
}

/// Slice 7: unified email+password user identity.
/// Replaces the dev_ctl_/op_sess_/op-pairing trio. A single user_session_token
/// bearer authenticates every human Slock REST call.
model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String   @map("password_hash") // bcrypt cost 12
  /// Human presence: stamped on WS subscribe and on the online→offline
  /// transition. Null = never connected since the column landed.
  lastSeenAt        DateTime? @map("last_seen_at")
  /// R1: user-editable display name. Avatar is derived (identicon of displayName||email);
  /// no avatar column yet — add avatar_blob_id only if/when custom upload ships.
  displayName       String?  @map("display_name")
  defaultWorkroomId String?  @map("default_workroom_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  sessions             UserSession[]
  memberships          UserWorkroomMembership[]
  devices              Device[]
  accountComputerLinks AccountComputerLink[]
  // R4: human friendships (one canonical row per pair; query both sides).
  friendshipsOwned    UserFriendship[]         @relation("FriendshipOwner")
  friendshipsReceived UserFriendship[]         @relation("FriendshipFriend")

  @@map("users")
}

/// R4 (minimal collaboration): human-to-human friendship. ONE canonical row per pair
/// (userId = lexicographically smaller id, friendId = larger) so @@unique dedupes both
/// directions. `requestedBy` records who initiated; `status` is pending|accepted.
/// Friends are discovered by exact email (no search). Query a user's accepted friends:
/// where (userId=me OR friendId=me) AND status='accepted'.
model UserFriendship {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  friendId    String   @map("friend_id")
  status      String   @default("pending") // pending | accepted
  requestedBy String   @map("requested_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user   User @relation("FriendshipOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId])
  @@map("user_friendships")
}

/// Slice 7: (user, workroom, role). Role is 'owner' only in this slice;
/// schema-ready for admin/member/guest later.
model UserWorkroomMembership {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  workroomId String   @map("workroom_id") @db.Uuid
  role       String   @default("owner")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workroomId])
  @@index([workroomId])
  @@map("user_workroom_memberships")
}

/// Slice 7: bearer-token session. token_hash = sha256(user_sess_...).
/// Sliding refresh: any 200 response bumps expiresAt to now+30d (throttled 12h).
/// deviceId is optional — set when signin runs alongside a device JWT (iOS app).
model UserSession {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  deviceId   String?   @map("device_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("user_sessions")
}

/// Links two devices together (bidirectional access).
/// Created during QR pairing. Both devices can see each other's sessions.
model DeviceLink {
  id             String   @id @default(cuid())
  sourceDeviceId String
  targetDeviceId String
  sourceDevice   Device   @relation("LinkSource", fields: [sourceDeviceId], references: [id])
  targetDevice   Device   @relation("LinkTarget", fields: [targetDeviceId], references: [id])
  createdAt      DateTime @default(now())

  @@unique([sourceDeviceId, targetDeviceId])
  // Single-column indexes for the OR(source=X, target=X) lookups in
  // getAccessibleDeviceIds + canAccessSession + notifyLinkedIPhones. The
  // composite unique above can't serve either column alone, so without these
  // every socket message did a full DeviceLink scan.
  @@index([sourceDeviceId])
  @@index([targetDeviceId])
}

/// Account↔Computer ownership edge (account-only identity refactor, 2026-06-03).
/// Replaces DeviceLink for monitoring visibility. A computer is owned by AT MOST
/// one account at a time: UNIQUE(computerId). Visibility queries hit userId.
/// computerId references Device.id where kind='mac' (soft ref; no Prisma relation
/// to keep the hot visibility query a single indexed lookup and to avoid cascade
/// coupling — deletion handled explicitly in takeover/unlink paths).
model AccountComputerLink {
  id         String   @id @default(cuid())
  userId     String   @map("user_id") // User.id (cuid)
  computerId String   @map("computer_id") // Device.id where kind='mac' (cuid)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([computerId]) // single-account-ownership
  @@index([userId]) // visibility: links by account
  @@map("account_computer_links")
}

model Session {
  id              String   @id @default(cuid())
  tag             String
  deviceId        String
  device          Device   @relation(fields: [deviceId], references: [id])
  metadata        String
  metadataVersion Int      @default(0)
  seq             Int      @default(0)
  active          Boolean  @default(true)
  lastActiveAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages SessionMessage[]

  @@unique([deviceId, tag])
  @@index([deviceId, updatedAt(sort: Desc)])
}

model SessionMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  localId   String?
  seq       Int
  content   String
  createdAt DateTime @default(now())

  @@unique([sessionId, localId])
  @@index([sessionId, seq])
}

model PairingRequest {
  id               String   @id @default(cuid())
  tempPublicKey    String   @unique
  shortCode        String?  @unique // 6-char human-readable pairing code
  serverUrl        String
  deviceName       String
  response         String?
  responseDeviceId String?
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@index([tempPublicKey])
  @@index([shortCode])
}

/// Launch presets for a Mac MioIsland device.
/// iPhone fetches these to show the user what commands can be remote-launched.
model LaunchPreset {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name      String
  command   String
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId, sortOrder])
}

/// Known project paths for a Mac MioIsland device.
/// Mac uploads its session cwds + recent project list; iPhone uses these
/// when picking a project for a remote-launched session.
model KnownProject {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  path       String
  name       String
  lastSeenAt DateTime @default(now())

  @@unique([deviceId, path])
  @@index([deviceId, lastSeenAt(sort: Desc)])
}

model PushToken {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id])
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, token])
}

/// Live Activity push token (scoped to a session).
/// iOS generates a token per active Live Activity.
model LiveActivityToken {
  id        String   @id @default(cuid())
  deviceId  String
  sessionId String
  token     String // APNs push token for this specific activity
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, sessionId])
  @@index([sessionId])
}

/// One row per StoreKit 2 originalTransactionId. Holds the trial/active
/// state independent of any single device, so a paid Apple ID can move
/// across devices without losing entitlement.
model Subscription {
  id                    String    @id @default(cuid())
  originalTransactionId String    @unique
  status                String    @default("active") // 'trial' | 'active' | 'expired' | 'revoked'
  trialStartedAt        DateTime?
  trialExpiresAt        DateTime?
  paidAt                DateTime?
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  devices SubscriptionDevice[]
}

/// Join table — many devices can share one Subscription (same Apple ID).
model SubscriptionDevice {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  deviceId       String
  createdAt      DateTime     @default(now())

  @@unique([subscriptionId, deviceId])
  @@index([deviceId])
}

/// Promotional / referral codes that grant a fixed-duration trial.
model RedeemCode {
  id           String    @id @default(cuid())
  code         String    @unique
  durationDays Int       @default(30)
  maxUses      Int       @default(1)
  usedCount    Int       @default(0)
  createdBy    String?
  note         String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  usages RedeemCodeUsage[]
}

/// Tracks which device redeemed which code, with the resulting grant window.
model RedeemCodeUsage {
  id           String     @id @default(cuid())
  redeemCodeId String
  redeemCode   RedeemCode @relation(fields: [redeemCodeId], references: [id])
  deviceId     String
  grantedUntil DateTime
  createdAt    DateTime   @default(now())

  @@unique([redeemCodeId, deviceId])
  @@index([deviceId])
}

// ============================================================
// CONTROL PLANE — Server Control Plane (feat/server-control-plane)
// ERD source: erd-api-contract.md v3 (4d5d06e6)
// All new models use UUID PKs (distinct from legacy CUID models above)
// @db.Uuid annotations align Prisma String fields with native PostgreSQL UUID
// columns in the migration SQL, preventing `prisma migrate dev` from generating
// spurious PK-type drift migrations (UUID→TEXT flip). Arrays (String[]) cannot
// carry @db.Uuid and are left as-is.
// ============================================================

/// Top-level org/team boundary.
model ControlOrg {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  ownerUserId String   @map("owner_user_id") @db.Uuid
  billingPlan String   @default("free") @map("billing_plan")
  createdAt   DateTime @default(now()) @map("created_at")

  credentials ControlCredential[]
  workrooms   ControlWorkroom[]
  agents      ControlAgent[]
  artifacts   ControlArtifact[]
  machines    ControlMachine[]

  @@map("control_orgs")
}

/// Credential/secret alias. Content lives in secure vault, never in DB.
model ControlCredential {
  id                 String     @id @default(uuid()) @db.Uuid
  orgId              String     @map("org_id") @db.Uuid
  org                ControlOrg @relation(fields: [orgId], references: [id])
  alias              String
  kind               String // asc_api_key | vercel_token | ssh_key | cert | env_group | other
  storageRef         String     @map("storage_ref") // pointer to vault; never plain secret
  scopeMode          String     @default("workroom") @map("scope_mode")
  // 'workroom': scope_workroom_ids ≥1 required
  // 'org':      org-wide (admin-only, enforced in API layer)
  scopeWorkroomIds   String[]   @default([]) @map("scope_workroom_ids")
  // UUID strings; app-layer validates org membership
  allowedActionKinds String[]   @default([]) @map("allowed_action_kinds")
  // empty = no restriction
  // allowedRuntimeKinds: deferred to post-v1 (no server-authoritative runtime source yet)
  revoked            Boolean    @default(false)
  revokedAt          DateTime?  @map("revoked_at")
  expiresAt          DateTime?  @map("expires_at")
  createdBy          String     @map("created_by") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at")
  lastUsedAt         DateTime?  @map("last_used_at")

  accessLogs ControlCredentialAccessLog[]

  @@unique([orgId, alias])
  @@map("control_credentials")
}

/// Audit log for credential resolution events. NEVER contains secret values.
model ControlCredentialAccessLog {
  id           String            @id @default(uuid()) @db.Uuid
  credentialId String            @map("credential_id") @db.Uuid
  credential   ControlCredential @relation(fields: [credentialId], references: [id])
  actionId     String            @map("action_id") @db.Uuid
  action       ControlAction     @relation(fields: [actionId], references: [id])
  machineId    String            @map("machine_id") @db.Uuid
  success      Boolean
  reasonCode   String?           @map("reason_code") // controlled enum on failure; NEVER secret values
  accessedAt   DateTime          @default(now()) @map("accessed_at")

  @@index([credentialId])
  @@index([actionId])
  @@map("control_credential_access_logs")
}

/// Machine registered by mio-agent daemon. machine_token stored in Keychain, not here.
model ControlMachine {
  id             String      @id @default(uuid()) @db.Uuid // permanent machine UUID
  orgId          String?     @map("org_id") @db.Uuid
  org            ControlOrg? @relation(fields: [orgId], references: [id])
  displayName    String?     @map("display_name")
  platform       String      @default("darwin") // darwin | linux
  arch           String      @default("arm64") // arm64 | x64
  tokenHash      String      @map("token_hash") // SHA-256 of machine_token; actual token is in Keychain on Mac
  tokenExpiresAt DateTime    @map("token_expires_at")
  boundAt        DateTime?   @map("bound_at") // when bind-org was called
  lastSeenAt     DateTime?   @map("last_seen_at")
  // Latest Claude/Codex subscription-usage snapshot reported by the daemon's
  // heartbeat ({sampled_at, claude:{...}, codex:{...}}). Display-only.
  usageSnapshot  Json?       @map("usage_snapshot")
  createdAt      DateTime    @default(now()) @map("created_at")

  sessions      ControlSession[]
  // R2.3: monitoring Devices bridged to this machine (see Device.controlMachineId).
  linkedDevices Device[]

  @@map("control_machines")
}

/// Workroom / collaborative channel for a project.
/// current_goal_id is a plain UUID reference (nullable; breaks circular FK).
model ControlWorkroom {
  id            String     @id @default(uuid()) @db.Uuid
  orgId         String     @map("org_id") @db.Uuid
  org           ControlOrg @relation(fields: [orgId], references: [id])
  name          String
  description   String?
  visibility    String     @default("private") // public | private
  purpose       String?
  currentGoalId String?    @map("current_goal_id") @db.Uuid // nullable UUID; no Prisma relation (circular)
  createdBy     String     @map("created_by") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")
  archivedAt    DateTime?  @map("archived_at")
  /// Monotone event-seq counter for control_event_logs. Allocation is a single
  /// `UPDATE ... SET event_seq = event_seq + 1 RETURNING` — replaces the old
  /// FOR UPDATE + SELECT MAX(seq) scan whose lock window grew with table size
  /// and convoyed every event publisher in the workroom (pool-exhaustion risk).
  eventSeq      BigInt     @default(0) @map("event_seq")

  goals             ControlGoal[]
  messages          ControlMessage[]
  channels          ControlChannel[]
  sessions          ControlSession[]
  tasks             ControlTask[]
  actions           ControlAction[]
  approvals         ControlApproval[]
  artifacts         ControlArtifact[]
  artifactPointers  ControlArtifactPointer[]
  workingAgreements ControlWorkingAgreement[]
  handoffs          ControlHandoff[]
  summaries         ControlWorkroomSummary[]
  roleInsights      ControlRoleInsight[]
  routerDecisions   ControlRouterDecision[]
  eventLogs         ControlEventLog[]

  @@map("control_workrooms")
}

/// Channel within a workroom (S1). type: main | standard | dm. visibility: public | private.
/// public channels are implicitly visible to all workroom members; private/dm require ControlChannelMember.
model ControlChannel {
  id             String                 @id @default(uuid()) @db.Uuid
  workroomId     String                 @map("workroom_id") @db.Uuid
  name           String
  type           String // "main" | "standard" | "dm"
  visibility     String // "public" | "private"
  // 客户频道关联的内部开发频道(派发默认/锁定目标)。仅 type='client' 使用。
  linkedChannelId String?               @map("linked_channel_id") @db.Uuid
  description    String?
  createdBy      String                 @map("created_by") // opaque actor id (non-uuid; e.g. 'system' / operatorSubject)
  archivedAt     DateTime?              @map("archived_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  lastActivityAt DateTime?              @map("last_activity_at")
  /// Monotone message-seq counter (same pool-stability rationale as
  /// ControlWorkroom.eventSeq — replaces FOR UPDATE + MAX(seq) in nextChannelSeq).
  messageSeq     BigInt                 @default(0) @map("message_seq")
  /// Elected "core agent" for this channel: the single agent that answers
  /// messages which @-mention nobody. Chosen by an LLM (Doubao) from member
  /// agents' descriptions whenever the roster/roles change, cached here so the
  /// per-message routing decision is a cheap lookup. Nullable until first
  /// election (or when the channel has no agents). ControlAgent.id (uuid).
  coreAgentId    String?                @map("core_agent_id") @db.Uuid
  workroom       ControlWorkroom        @relation(fields: [workroomId], references: [id])
  members        ControlChannelMember[]
  messages       ControlMessage[]

  @@index([workroomId, archivedAt])
  @@index([workroomId, type])
  @@map("control_channels")
}

/// Explicit member row for private/dm channels. public channels need no rows.
model ControlChannelMember {
  id        String         @id @default(uuid()) @db.Uuid
  channelId String         @map("channel_id") @db.Uuid
  memberId  String         @map("member_id") // opaque actor id (agent/human/operatorSubject; non-uuid)
  addedAt   DateTime       @default(now()) @map("added_at")
  channel   ControlChannel @relation(fields: [channelId], references: [id])

  @@unique([channelId, memberId])
  @@map("control_channel_members")
}

/// Goal for a workroom.
model ControlGoal {
  id                  String          @id @default(uuid()) @db.Uuid
  workroomId          String          @map("workroom_id") @db.Uuid
  workroom            ControlWorkroom @relation(fields: [workroomId], references: [id])
  sourceMessageId     String?         @map("source_message_id") @db.Uuid
  title               String
  description         String          @default("")
  successCriteria     String          @default("") @map("success_criteria")
  status              String          @default("active") // active | paused | in_review | achieved | canceled
  ownerUserId         String          @map("owner_user_id") @db.Uuid
  currentTaskIds      String[]        @map("current_task_ids")
  acceptedArtifactIds String[]        @map("accepted_artifact_ids")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  workroomSummaries ControlWorkroomSummary[]

  @@index([workroomId])
  @@map("control_goals")
}

/// Agent (AI agent or human proxy) registered in the system.
model ControlAgent {
  id           String     @id @default(uuid()) @db.Uuid
  orgId        String     @map("org_id") @db.Uuid
  org          ControlOrg @relation(fields: [orgId], references: [id])
  name         String
  displayName  String     @map("display_name")
  role         String // ops | pm | engineer | designer | researcher | other
  description  String     @default("")
  capabilities Json       @default("{}")
  runtime      String? // claude | codex | opencode | kimi | other
  // Model identifier the agent should run (e.g. "opus" | "sonnet"). Nullable: existing rows + agents
  // that have not specified a model leave it null (daemon falls back to its runtime default). Env vars
  // are kept in capabilities.env (Json) — there is intentionally NO env column.
  model        String? // e.g. opus | sonnet (runtime model alias); null = runtime default
  machineId    String?    @map("machine_id")
  status       String     @default("offline") // online | offline | busy | drain
  permissions  Json       @default("{}")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tasks            ControlTask[]                    @relation("TaskOwner")
  createdTasks     ControlTask[]                    @relation("TaskCreator")
  actedActions     ControlAction[]                  @relation("ActionActor")
  createdArtifacts ControlArtifact[]                @relation("ArtifactCreator")
  verificationLogs ControlArtifactVerificationLog[]
  handoffs         ControlHandoff[]                 @relation("HandoffTarget")
  roleInsights     ControlRoleInsight[]

  // NOTE: deliberately NON-unique. A machine may host MANY agents (the "Create Agent"
  // feature), so (orgId, machineId) is an ordinary lookup index, not a uniqueness
  // constraint. bind-org idempotency is preserved at the app layer (findFirst-then-create).
  @@index([orgId, machineId])
  @@index([orgId, status])
  @@map("control_agents")
}

/// Message in a workroom timeline.
model ControlMessage {
  id                   String          @id @default(uuid()) @db.Uuid
  workroomId           String          @map("workroom_id") @db.Uuid
  workroom             ControlWorkroom @relation(fields: [workroomId], references: [id])
  channelId            String          @map("channel_id") @db.Uuid // NOT NULL (DB enforced by s1_channelid_notnull migration)
  seq                  BigInt          @default(0) @map("seq") // per-channel monotone; nextChannelSeq assigns explicitly; default 0 is never relied upon
  clientIdempotencyKey String?         @map("client_idempotency_key")
  senderKind           String          @map("sender_kind") // user | agent | system
  senderId             String          @map("sender_id") // opaque actor id (may be 'pairing:<uuid>' for op_sess_ human sends)
  content              String
  // AGENT mentions only. The live Postgres column is `uuid[]` (see add_control_plane
  // migration) — it can ONLY hold ControlAgent.id (uuid). Human users have cuid ids
  // which would crash this column; they go in userMentions below.
  // @default([]) on the array columns is REQUIRED to match the hand-written
  // migrations (DEFAULT '{}'): without it, a db-push/migrate-dev database gets
  // NOT NULL columns with NO default, and inserts that omit the field 500 with
  // P2011 (verified live 2026-06-12). Keep schema and migration SQL in lockstep.
  mentions             String[]        @default([])
  // S2 (Task #121): HUMAN (real-person) mentions. User.id is a cuid, NOT a uuid, so it
  // cannot live in the uuid[] `mentions` column. This is a plain text[] column. The
  // activity feed + mention-push match a human viewer's user.id against this array.
  userMentions         String[]        @default([]) @map("user_mentions")
  hashRefs             Json            @default("{}") @map("hash_refs")
  attachmentIds        String[]        @default([]) @map("attachment_ids")
  embeddedCardType     String?         @map("embedded_card_type")
  embeddedCardId       String?         @map("embedded_card_id") @db.Uuid
  threadReplyCount     Int             @default(0) @map("thread_reply_count")
  lastThreadReplyAt    DateTime?       @map("last_thread_reply_at")
  parentMessageId      String?         @map("parent_message_id") @db.Uuid // S2: null=top-level, non-null=reply to that parent message (no FK; control-plane self-ref convention)
  createdAt            DateTime        @default(now()) @map("created_at")

  channel           ControlChannel            @relation(fields: [channelId], references: [id])
  attachments       ControlAttachment[]
  thread            ControlThread?
  workingAgreements ControlWorkingAgreement[] @relation("AgreementSourceMessage")
  handoffs          ControlHandoff[]          @relation("HandoffSourceMessage")
  roleInsights      ControlRoleInsight[]
  routerDecisions   ControlRouterDecision[]

  @@unique([channelId, seq])
  @@unique([channelId, clientIdempotencyKey])
  @@index([workroomId, createdAt(sort: Desc)])
  @@index([channelId, seq])
  @@index([parentMessageId])
  @@map("control_messages")
}

/// Attachment on a message or thread reply.
model ControlAttachment {
  id                   String          @id @default(uuid()) @db.Uuid
  workroomId           String          @map("workroom_id") @db.Uuid
  messageId            String?         @map("message_id") @db.Uuid
  message              ControlMessage? @relation(fields: [messageId], references: [id])
  threadReplyId        String?         @map("thread_reply_id") @db.Uuid
  uploaderKind         String          @map("uploader_kind") // user | agent | daemon
  // text (not uuid): agent uploaders are uuid ControlAgent.ids, HUMAN uploaders
  // are cuid User.ids (S8 human-attachment uploads) — same split as mentions.
  uploaderId           String          @map("uploader_id")
  filename             String
  mimeType             String          @map("mime_type")
  sizeBytes            BigInt          @map("size_bytes")
  previewMetadata      Json?           @map("preview_metadata")
  sensitivity          String          @default("normal") // normal | secret
  classificationSource String          @default("uploader") @map("classification_source")
  policyResult         String          @default("allowed") @map("policy_result")
  storageKey           String?         @map("storage_key")
  credentialAliasRef   String?         @map("credential_alias_ref")
  permissionScope      String          @default("members") @map("permission_scope")
  data                 Bytes?          @map("data")
  channelId            String?         @map("channel_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at")

  @@index([workroomId])
  @@map("control_attachments")
}

/// Per-user read cursor for a channel (unread badges). Composite PK; no FK to
/// channels so deletes stay simple (stale rows are harmless and tiny).
model ControlChannelRead {
  channelId   String   @map("channel_id") @db.Uuid
  userId      String   @map("user_id")
  lastReadSeq BigInt   @default(0) @map("last_read_seq")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([channelId, userId])
  @@map("control_channel_reads")
}

/// Thread attached to a workroom message.
model ControlThread {
  id              String         @id @default(uuid()) @db.Uuid
  parentMessageId String         @unique @map("parent_message_id") @db.Uuid
  parentMessage   ControlMessage @relation(fields: [parentMessageId], references: [id])
  workroomId      String         @map("workroom_id") @db.Uuid
  replyCount      Int            @default(0) @map("reply_count")
  lastReplyAt     DateTime?      @map("last_reply_at")

  tasks ControlTask[]

  @@index([workroomId])
  @@map("control_threads")
}

/// S5: a message saved (bookmarked) by a caller subject (operator subject or machine id).
/// No FK (control-plane self-reference convention). subjectId is opaque text
/// (op_sess_ operatorSubjectId like 'pairing:<uuid>', or machine.id).
model ControlSavedMessage {
  id         String   @id @default(uuid()) @db.Uuid
  workroomId String   @map("workroom_id") @db.Uuid
  subjectId  String   @map("subject_id")
  messageId  String   @map("message_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([subjectId, messageId])
  @@index([subjectId])
  @@map("control_saved_messages")
}

/// S5: per-subject handled-state for an activity (mention) item.
/// No FK (control-plane self-reference convention). subjectId is opaque text
/// (op_sess_ operatorSubjectId like 'pairing:<uuid>', machine.id, or a ControlAgent.id).
/// One row per (subject, message); handled defaults false ("unhandled" ≈ "unread", no
/// per-message read-cursor this MVP). UNIQUE(subjectId, messageId) makes upsert idempotent.
model ControlActivityState {
  id        String   @id @default(uuid()) @db.Uuid
  subjectId String   @map("subject_id")
  messageId String   @map("message_id") @db.Uuid
  handled   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([subjectId, messageId])
  @@index([subjectId])
  @@map("control_activity_state")
}

/// AI/runtime session (cmux | daemon | applescript).
model ControlSession {
  id             String          @id @default(uuid()) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  workroomId     String          @map("workroom_id") @db.Uuid
  workroom       ControlWorkroom @relation(fields: [workroomId], references: [id])
  machineId      String?         @map("machine_id") @db.Uuid
  machine        ControlMachine? @relation(fields: [machineId], references: [id])
  mode           String // cmux | daemon | applescript
  runtime        String // claude | codex | opencode | kimi | other
  displayName    String          @map("display_name")
  status         String          @default("idle")
  // idle | running | waiting_for_user | blocked | completed | failed | disconnected | reconnecting
  currentTaskId  String?         @map("current_task_id") @db.Uuid // UI cache only; Task is source of truth
  capabilities   Json            @default("{}")
  lastActivityAt DateTime        @default(now()) @map("last_activity_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  actions   ControlAction[]
  approvals ControlApproval[]
  artifacts ControlArtifact[]

  @@index([workroomId, status])
  @@index([machineId])
  @@map("control_sessions")
}

/// Task — work item with atomic CAS claim.
model ControlTask {
  id                String          @id @default(uuid()) @db.Uuid
  workroomId        String          @map("workroom_id") @db.Uuid
  workroom          ControlWorkroom @relation(fields: [workroomId], references: [id])
  channelId         String?         @map("channel_id") @db.Uuid // Slock (S3): channel the task belongs to. nullable → existing rows safe
  // Slock (S2): per-channel task number (1-based). null for workroom-level tasks (channelId=null).
  // Partial unique index (channel_id, number) WHERE both non-null is in the migration SQL — not @@unique here.
  number            Int?
  goalId            String?         @map("goal_id") @db.Uuid
  // 客户频道任务桥(07-09):内部镜像任务指向客户频道的需求单。内部任务状态
  // 变化时单向回流到源需求单(粗粒度映射);源单无此字段,天然防环。
  mirrorOfTaskId    String?         @map("mirror_of_task_id") @db.Uuid
  sourceMessageId   String?         @map("source_message_id") @db.Uuid
  title             String
  description       String          @default("")
  ownerRole         String?         @map("owner_role")
  ownerInstanceId   String?         @map("owner_instance_id") @db.Uuid // FK → ControlAgent; CAS claim
  ownerAgent        ControlAgent?   @relation("TaskOwner", fields: [ownerInstanceId], references: [id])
  creatorInstanceId String?         @map("creator_instance_id") @db.Uuid
  creatorAgent      ControlAgent?   @relation("TaskCreator", fields: [creatorInstanceId], references: [id])
  status            String          @default("todo")
  // todo | in_progress | waiting_approval | in_review | done | canceled
  // P3 reviewer-gate: # of adversarial-review rounds this task has entered. The
  // done→in_review divert increments it; a re-submit at >= MAX_REVIEW_ROUNDS falls
  // through to done (1-bounce cap — no review↔rework loop). See taskReview.ts.
  reviewRound       Int             @default(0) @map("review_round")
  linkedSessionIds  String[]        @map("linked_session_ids")
  threadId          String?         @map("thread_id") @db.Uuid
  thread            ControlThread?  @relation(fields: [threadId], references: [id])
  // Bug-2 Thread feature: when set, this task is "attached" to that message;
  // that message becomes the thread parent. iOS surfaces the task chip on the
  // parent message. No FK (control-plane self-ref convention). v1: no DB-level
  // uniqueness — server enforces "first wins" via ORDER BY created_at ASC LIMIT 1
  // in the messages read path. See migration 20260527010000_bug2_task_parent_message.
  parentMessageId   String?         @map("parent_message_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  actions   ControlAction[]
  approvals ControlApproval[]
  artifacts ControlArtifact[]
  handoffs  ControlHandoff[]

  @@index([workroomId, status])
  @@index([ownerInstanceId])
  @@index([creatorInstanceId])
  @@index([channelId])
  @@index([parentMessageId])
  @@map("control_tasks")
}

/// Action proposed by a session. Requires approval when irreversible_no_abort.
/// approval_id is a plain String (breaks circular FK with ControlApproval).
model ControlAction {
  id                      String          @id @default(uuid()) @db.Uuid
  sessionId               String          @map("session_id") @db.Uuid
  session                 ControlSession  @relation(fields: [sessionId], references: [id])
  workroomId              String          @map("workroom_id") @db.Uuid
  workroom                ControlWorkroom @relation(fields: [workroomId], references: [id])
  taskId                  String?         @map("task_id") @db.Uuid
  task                    ControlTask?    @relation(fields: [taskId], references: [id])
  actorAgentId            String          @map("actor_agent_id") @db.Uuid
  actorAgent              ControlAgent    @relation("ActionActor", fields: [actorAgentId], references: [id])
  kind                    String // deploy | upload | db_migrate | env_change | ...
  summary                 String
  reversibility           String // reversible | irreversible_abortable | irreversible_no_abort
  riskLevel               String          @map("risk_level") // low | medium | high | critical
  status                  String          @default("proposed")
  // proposed | approved | rejected | canceled | fired | transmission_complete | reconciling | succeeded | failed | needs_human
  transmissionCompletedAt DateTime?       @map("transmission_completed_at")
  externalConfirmedAt     DateTime?       @map("external_confirmed_at")
  requiresApproval        Boolean         @default(false) @map("requires_approval")
  approvalId              String?         @map("approval_id") @db.Uuid // set at fire; no Prisma relation (circular)
  approvedAtSnapshot      DateTime?       @map("approved_at_snapshot")
  credentialAliasRef      String?         @map("credential_alias_ref")
  clientIdempotencyKey    String          @unique @map("client_idempotency_key")
  createdAt               DateTime        @default(now()) @map("created_at")
  // #83: bumped by Prisma on every action mutation — backs capabilities.action_version
  // (stale-write CAS marker for future operator-write endpoints).
  updatedAt               DateTime        @updatedAt @map("updated_at")
  firedAt                 DateTime?       @map("fired_at")

  // #88: operator write state — set atomically with audit row in ControlOperatorAuditLog
  operatorAcknowledgedAt DateTime? @map("operator_acknowledged_at")
  operatorReviewedAt     DateTime? @map("operator_reviewed_at")

  approvalConsumption  ControlActionApprovalConsumption?
  actionToken          ControlActionToken?
  reconciliations      ControlActionReconciliation[]
  artifacts            ControlArtifact[]
  approvals            ControlApproval[]
  credentialAccessLogs ControlCredentialAccessLog[]
  operatorAuditLogs    ControlOperatorAuditLog[]

  @@index([workroomId, status])
  @@index([sessionId])
  @@map("control_actions")
}

/// Approval — pre-action gate or artifact review.
/// action_id and artifact_id are plain String NULLable to break circular FKs.
model ControlApproval {
  id              String          @id @default(uuid()) @db.Uuid
  workroomId      String          @map("workroom_id") @db.Uuid
  workroom        ControlWorkroom @relation(fields: [workroomId], references: [id])
  sessionId       String?         @map("session_id") @db.Uuid
  session         ControlSession? @relation(fields: [sessionId], references: [id])
  taskId          String?         @map("task_id") @db.Uuid
  task            ControlTask?    @relation(fields: [taskId], references: [id])
  actionId        String?         @map("action_id") @db.Uuid
  action          ControlAction?  @relation(fields: [actionId], references: [id])
  artifactId      String?         @map("artifact_id") @db.Uuid // nullable UUID; no Prisma relation (circular)
  kind            String // pre_action | disposal | artifact_review
  status          String          @default("pending")
  // pending | approved | consumed | rejected | snoozed | expired | ignored | rolled_forward | accepted | changes_requested | remediation_created
  reviewerUserId  String?         @map("reviewer_user_id") @db.Uuid
  riskSummary     String          @default("") @map("risk_summary")
  evidenceSummary String          @default("") @map("evidence_summary")
  createdAt       DateTime        @default(now()) @map("created_at")
  expiresAt       DateTime?       @map("expires_at")
  decidedAt       DateTime?       @map("decided_at")

  approvalConsumption ControlActionApprovalConsumption?

  @@index([workroomId, status])
  @@map("control_approvals")
}

/// Evidence records for daemon-reported reconcile attempts (Phase 5C).
/// UNIQUE(actionId, evidenceId) — same daemon-generated file = idempotent re-report.
/// Multiple different evidence records are allowed per action (audit trail).
/// machine_id: the machine that fired the action (from ControlActionToken; verified at reconcile).
/// Status semantics: action status is advanced to 'needs_human' on first reconcile;
///   subsequent reconcile calls only add evidence records (no state change, no duplicate events).
model ControlActionReconciliation {
  id              String        @id @default(uuid()) @db.Uuid
  actionId        String        @map("action_id") @db.Uuid
  action          ControlAction @relation(fields: [actionId], references: [id])
  evidenceId      String        @map("evidence_id") // stable file-based ID from daemon
  reasonCode      String        @map("reason_code") // controlled enum: fire_response_lost_token_unrecoverable | drain_deadline_exceeded
  machineId       String        @map("machine_id") @db.Uuid // bound at issuance (verified, not from body)
  // #59: optional runtime-produced warnings forwarded by the daemon (e.g.
  // CLAUDE_DELEGATION_CONFIG_NOT_PROVISIONED). Validated structure only:
  // [{ code, severity, message }]. Surfaced to control-plane as needs_human context.
  runtimeWarnings Json?         @map("runtime_warnings")
  // #141: productized runtime output summary + already-redacted runtime log excerpt, reported by
  // the daemon at reconcile. Surfaced (re-redacted server-side as defense-in-depth) via GET /actions
  // for the CodeLight Evidence / Runtime Log pushed pages. NULL until the daemon backfills (#141 daemon side).
  outputSummary   String?       @map("output_summary")
  rawLogRedacted  String?       @map("raw_log_redacted")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([actionId, evidenceId])
  @@map("control_action_reconciliations")
}

/// One-time action capability token. Raw token returned in fire response ONCE.
/// SHA-256 hash stored here — raw token never persisted.
/// Consumed by subprocess via POST /actions/:id/token/consume (action_token bearer auth, NOT machine_token).
/// UNIQUE(actionId) + UNIQUE(tokenHash) prevent double-issuance and hash collisions.
model ControlActionToken {
  id         String        @id @default(uuid()) @db.Uuid
  actionId   String        @unique @map("action_id") @db.Uuid
  action     ControlAction @relation(fields: [actionId], references: [id])
  tokenHash  String        @unique @map("token_hash")
  sessionId  String        @map("session_id") @db.Uuid
  workroomId String        @map("workroom_id") @db.Uuid
  machineId  String        @map("machine_id") @db.Uuid
  issuedAt   DateTime      @default(now()) @map("issued_at")
  expiresAt  DateTime      @map("expires_at")
  consumedAt DateTime?     @map("consumed_at")

  @@map("control_action_tokens")
}

/// Slice 6 (post-Slice-7): zero-touch machine enrollment. Mac creates intent
/// (no auth), an authenticated user approves it, Mac polls and atomically
/// claims the delivered machine_token exactly once. Security model mirrors
/// the previous control_operator_pairings: only sha256(opaque_code) stored;
/// uniform 403 on any failure (anti-enumeration); CAS one-time consume;
/// raw token returned exactly once via deliveredToken.
///
/// Slice 7: approver column renamed approved_by_op_sess → approved_by_user_id.
model ControlMachineEnrollment {
  id                 String    @id @default(uuid()) @db.Uuid
  codeHash           String    @unique @map("code_hash")
  deviceName         String    @map("device_name")
  platform           String
  arch               String
  createdAt          DateTime  @default(now()) @map("created_at")
  expiresAt          DateTime  @map("expires_at")
  approvedAt         DateTime? @map("approved_at")
  approvedByUserId   String?   @map("approved_by_user_id") // User.id (TEXT cuid); soft ref, no Prisma FK
  approvedWorkroomId String?   @map("approved_workroom_id") @db.Uuid // ControlWorkroom.id; recorded at approve time so the no-auth GET poll can return workroom_id without re-resolving auth
  machineId          String?   @map("machine_id") @db.Uuid
  deliveredToken     String?   @map("delivered_token")
  canceledAt         DateTime? @map("canceled_at")

  @@map("control_machine_enrollments")
}

/// ControlConnectionCredential (#179, Track 4) — the long-lived, refreshable ROOT credential for
/// CodeLight's "bind once, stay connected" model. Replaces the manual dev_ctl_/op_sess_ user flow.
///
/// SECURITY MODEL (mirrors the rest of the system — only sha256 stored, raw returned once):
///   - Minted at pairing redeem (extends #153). Raw `conn_...` returned exactly once → iOS Keychain.
///   - This credential is NEVER sent on data requests; it is exchanged at POST /connections/access
///     for SHORT-LIVED read/operator access tokens (existing dev_ctl_/op_sess_ classes, short TTL).
///   - Long-lived (default 60d) + ROLLING: each refresh may rotate it (rotatedFromId lineage) so a
///     leaked snapshot ages out.
///   - revokedAt is the single kill switch: revoke → next /access exchange fails → all derived access
///     dies within the access TTL (bounded exposure). Self-revoke (by the credential itself, phone
///     "disconnect") AND machine_token revoke (Mac/daemon device management) are both allowed.
///   - scopes carries what was granted at bind: ["read"] or ["read","operator"]. Operator access is
///     only ever minted when "operator" ∈ scopes (no silent scope escalation).
model ControlConnectionCredential {
  id                 String    @id @default(uuid()) @db.Uuid // connection_id
  credentialHash     String    @unique @map("credential_hash") // sha256(conn_...), never raw
  orgId              String    @map("org_id") @db.Uuid
  workroomId         String    @map("workroom_id") @db.Uuid
  scopes             String[]  @map("scopes") // granted scopes: read, operator
  operatorSubjectId  String?   @map("operator_subject_id") // opaque operator identity (set iff operator granted)
  allowedCommands    String[]  @map("allowed_commands") // operator command keys to mint into operator access (V1: ack+mark_reviewed)
  deviceLabel        String?   @map("device_label") // non-secret display label (e.g. "Laurent's iPhone")
  createdByMachineId String?   @map("created_by_machine_id") @db.Uuid // Mac/daemon that authorized the bind
  rotatedFromId      String?   @map("rotated_from_id") @db.Uuid // rolling-refresh lineage (previous credential id)
  createdAt          DateTime  @default(now()) @map("created_at")
  expiresAt          DateTime  @map("expires_at") // long-lived (default 60d)
  lastRefreshAt      DateTime? @map("last_refresh_at")
  revokedAt          DateTime? @map("revoked_at") // single kill switch

  @@index([workroomId])
  @@map("control_connection_credentials")
}

/// ControlOperatorAuditLog (#88) — immutable audit record for operator write commands.
///
/// WRITTEN IN THE SAME Prisma $transaction as the state mutation on ControlAction.
/// Transaction failure rolls back BOTH mutation AND audit row — no orphan rows.
///
/// SECURITY (no-leak):
///   - Never contains: raw token, secret, storage_ref, raw evidence, stack traces, paths.
///   - Only controlled metadata: command enum + action/session/workroom IDs + opaque operator ID + outcome enum.
///   - clientIdempotencyKey UNIQUE constraint is the backstop against double-submission.
///
/// V1 commands: acknowledge_needs_human, mark_reviewed
/// V2 commands: approve, retry (added when #97 write endpoints are ready)
model ControlOperatorAuditLog {
  id                   String   @id @default(uuid()) @db.Uuid
  sessionId            String   @map("session_id") @db.Uuid // ControlOperatorSession.id (no Prisma FK — consistent with rest of system)
  workroomId           String   @map("workroom_id") @db.Uuid
  actionId             String?  @map("action_id") @db.Uuid // nullable for future session-level commands
  commandKey           String   @map("command_key") // acknowledge_needs_human | mark_reviewed | approve | retry
  operatorSubjectId    String   @map("operator_subject_id") // opaque — copied from session; never raw token
  outcome              String   @map("outcome") // succeeded | rejected_*
  clientIdempotencyKey String   @unique @map("client_idempotency_key")
  decidedAt            DateTime @default(now()) @map("decided_at")

  action ControlAction? @relation(fields: [actionId], references: [id])

  @@index([actionId])
  @@index([sessionId])
  @@map("control_operator_audit_logs")
}

/// Atomic fire-gate: one approval → one irreversible_no_abort action. DB-level enforcement.
/// Both columns have UNIQUE constraints. Fire transaction INSERTs here atomically.
model ControlActionApprovalConsumption {
  id         String          @id @default(uuid()) @db.Uuid
  approvalId String          @unique @map("approval_id") @db.Uuid
  approval   ControlApproval @relation(fields: [approvalId], references: [id])
  actionId   String          @unique @map("action_id") @db.Uuid
  action     ControlAction   @relation(fields: [actionId], references: [id])
  consumedAt DateTime        @default(now()) @map("consumed_at")

  @@map("control_action_approval_consumptions")
}

/// Artifact — evidence of work progress. Three-state milestone.
model ControlArtifact {
  id                   String          @id @default(uuid()) @db.Uuid
  orgId                String          @map("org_id") @db.Uuid
  org                  ControlOrg      @relation(fields: [orgId], references: [id])
  workroomId           String          @map("workroom_id") @db.Uuid
  workroom             ControlWorkroom @relation(fields: [workroomId], references: [id])
  taskId               String?         @map("task_id") @db.Uuid
  task                 ControlTask?    @relation(fields: [taskId], references: [id])
  sessionId            String?         @map("session_id") @db.Uuid
  session              ControlSession? @relation(fields: [sessionId], references: [id])
  actionId             String?         @map("action_id") @db.Uuid
  action               ControlAction?  @relation(fields: [actionId], references: [id])
  scopeType            String          @map("scope_type") // org | workroom | task | session | action
  type                 String
  // prd | design | code_path | build | deployment_url | ipa_upload | test_report | runbook | log | screenshot
  title                String
  summary              String          @default("")
  url                  String?
  localPath            String?         @map("local_path")
  hash                 String?
  externalId           String?         @map("external_id")
  status               String          @default("created")
  // created | verified | external_confirmed | accepted | superseded | rejected | expired | disposed | ignored | rolled_forward
  verifiedAt           DateTime?       @map("verified_at") // milestone 1: agent verified
  externalConfirmedAt  DateTime?       @map("external_confirmed_at") // milestone 2: external system confirmed
  humanAckedAt         DateTime?       @map("human_acked_at") // milestone 3: human accepted
  disposalStatus       String          @default("none") @map("disposal_status")
  // none | expired | ignored | rolled_forward | remediation_created
  currentPointerKey    String?         @map("current_pointer_key")
  createdByAgentId     String?         @map("created_by_agent_id") @db.Uuid
  createdByAgent       ControlAgent?   @relation("ArtifactCreator", fields: [createdByAgentId], references: [id])
  clientIdempotencyKey String          @unique @map("client_idempotency_key")
  createdAt            DateTime        @default(now()) @map("created_at")

  verificationLogs ControlArtifactVerificationLog[]
  pointers         ControlArtifactPointer[]

  @@index([workroomId, type])
  @@index([sessionId])
  @@map("control_artifacts")
}

/// Artifact pointer — "which artifact is current?" per semantic key per workroom.
model ControlArtifactPointer {
  id         String          @id @default(uuid()) @db.Uuid
  workroomId String          @map("workroom_id") @db.Uuid
  workroom   ControlWorkroom @relation(fields: [workroomId], references: [id])
  key        String // e.g. current_prd, current_deployment
  artifactId String          @map("artifact_id") @db.Uuid
  artifact   ControlArtifact @relation(fields: [artifactId], references: [id])
  updatedBy  String          @map("updated_by") @db.Uuid
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@unique([workroomId, key])
  @@map("control_artifact_pointers")
}

/// Artifact verification log — process evidence, not just a single status field.
model ControlArtifactVerificationLog {
  id                   String          @id @default(uuid()) @db.Uuid
  artifactId           String          @map("artifact_id") @db.Uuid
  artifact             ControlArtifact @relation(fields: [artifactId], references: [id])
  verifierAgentId      String          @map("verifier_agent_id") @db.Uuid
  verifierAgent        ControlAgent    @relation(fields: [verifierAgentId], references: [id])
  method               String
  // curl | hash_compare | app_store_check | browser_check | codesign_verify | ipa_inspect | manual
  status               String // passed | failed | inconclusive
  evidence             Json            @default("{}")
  error                String?
  clientIdempotencyKey String          @unique @map("client_idempotency_key")
  createdAt            DateTime        @default(now()) @map("created_at")

  @@index([artifactId])
  @@map("control_artifact_verification_logs")
}

/// Working agreement — persistent team-level rule discovered through collaboration.
model ControlWorkingAgreement {
  id                   String          @id @default(uuid()) @db.Uuid
  workroomId           String          @map("workroom_id") @db.Uuid
  workroom             ControlWorkroom @relation(fields: [workroomId], references: [id])
  participants         String[] // user/agent ids
  summary              String
  rules                Json            @default("[]")
  createdFromMessageId String?         @map("created_from_message_id") @db.Uuid
  createdFromMessage   ControlMessage? @relation("AgreementSourceMessage", fields: [createdFromMessageId], references: [id])
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  @@index([workroomId])
  @@map("control_working_agreements")
}

/// Handoff — structured work transfer between roles.
model ControlHandoff {
  id                   String          @id @default(uuid()) @db.Uuid
  workroomId           String          @map("workroom_id") @db.Uuid
  workroom             ControlWorkroom @relation(fields: [workroomId], references: [id])
  fromActorKind        String          @map("from_actor_kind") // user | agent
  fromActorId          String          @map("from_actor_id") @db.Uuid
  toRole               String          @map("to_role")
  toInstanceId         String?         @map("to_instance_id") @db.Uuid
  toAgent              ControlAgent?   @relation("HandoffTarget", fields: [toInstanceId], references: [id])
  taskId               String?         @map("task_id") @db.Uuid
  task                 ControlTask?    @relation(fields: [taskId], references: [id])
  inputArtifactIds     String[]        @map("input_artifact_ids")
  expectedOutput       String          @default("") @map("expected_output")
  acceptanceCriteria   String          @default("") @map("acceptance_criteria")
  status               String          @default("proposed")
  // proposed | accepted | declined | completed | canceled
  createdFromMessageId String?         @map("created_from_message_id") @db.Uuid
  createdFromMessage   ControlMessage? @relation("HandoffSourceMessage", fields: [createdFromMessageId], references: [id])
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  @@index([workroomId, status])
  @@map("control_handoffs")
}

/// Workroom summary — LLM-generated context digest for mobile first-load.
model ControlWorkroomSummary {
  id                    String          @id @default(uuid()) @db.Uuid
  workroomId            String          @map("workroom_id") @db.Uuid
  workroom              ControlWorkroom @relation(fields: [workroomId], references: [id])
  goalId                String?         @map("goal_id") @db.Uuid
  goal                  ControlGoal?    @relation(fields: [goalId], references: [id])
  headline              String
  currentPhase          String          @default("") @map("current_phase")
  activeOwnerSummary    Json            @default("{}") @map("active_owner_summary")
  needsAttentionCount   Int             @default(0) @map("needs_attention_count")
  latestArtifactIds     String[]        @map("latest_artifact_ids")
  blockedItems          Json            @default("[]") @map("blocked_items")
  nextRecommendedAction String          @default("") @map("next_recommended_action")
  generatedAt           DateTime        @default(now()) @map("generated_at")

  @@index([workroomId, generatedAt(sort: Desc)])
  @@map("control_workroom_summaries")
}

/// Role insight — proactive input from an agent watching the conversation.
model ControlRoleInsight {
  id                String          @id @default(uuid()) @db.Uuid
  workroomId        String          @map("workroom_id") @db.Uuid
  workroom          ControlWorkroom @relation(fields: [workroomId], references: [id])
  agentId           String          @map("agent_id") @db.Uuid
  agent             ControlAgent    @relation(fields: [agentId], references: [id])
  relatedMessageId  String?         @map("related_message_id") @db.Uuid
  relatedMessage    ControlMessage? @relation(fields: [relatedMessageId], references: [id])
  relatedObjectType String?         @map("related_object_type")
  relatedObjectId   String?         @map("related_object_id") @db.Uuid
  reason            String
  content           String
  suggestedAction   Json?           @map("suggested_action")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([workroomId, createdAt(sort: Desc)])
  @@map("control_role_insights")
}

/// Router decision log — why a message was routed to which agent(s).
model ControlRouterDecision {
  id                        String          @id @default(uuid()) @db.Uuid
  workroomId                String          @map("workroom_id") @db.Uuid
  workroom                  ControlWorkroom @relation(fields: [workroomId], references: [id])
  triggerMessageId          String?         @map("trigger_message_id") @db.Uuid
  triggerMessage            ControlMessage? @relation(fields: [triggerMessageId], references: [id])
  targetAgentIds            String[]        @map("target_agent_ids")
  reason                    String
  confidence                Float
  triggerType               String          @map("trigger_type")
  // explicit_mention | role_capability | artifact_type | task_owner | missing_perspective
  relatedObjectIds          Json            @default("{}") @map("related_object_ids")
  contextSelectionLog       Json            @default("{}") @map("context_selection_log")
  requiresHumanConfirmation Boolean         @default(false) @map("requires_human_confirmation")
  createTask                Boolean         @default(false) @map("create_task")
  createdAt                 DateTime        @default(now()) @map("created_at")

  @@index([workroomId, createdAt(sort: Desc)])
  @@map("control_router_decisions")
}

/// Event log — persisted before WS fanout. Monotonic seq per workroom.
/// Retention must cover max_catch_up_events (500). Pruning checks MIN(apply_seq) across ClientCursors.
model ControlEventLog {
  id          String          @id @default(uuid()) @db.Uuid
  workroomId  String          @map("workroom_id") @db.Uuid
  workroom    ControlWorkroom @relation(fields: [workroomId], references: [id])
  seq         BigInt // monotonically increasing per workroom
  eventId     String          @unique @map("event_id") @db.Uuid // stable dedup key
  topic       String // event topic string
  payloadJson Json            @map("payload_json")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@unique([workroomId, seq])
  @@index([workroomId, seq])
  @@map("control_event_logs")
}

/// Client cursor — per-device × per-scope catch-up position.
/// One row per (user, device, scope_type, scope_id, topic_group).
/// apply_seq: highest seq received and applied.
/// read_seq: highest seq human has visibly read (drives unread badge).
model ControlClientCursor {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  deviceId   String   @map("device_id")
  scopeType  String   @map("scope_type") // workroom | thread | session
  scopeId    String   @map("scope_id") @db.Uuid
  topicGroup String   @default("all") @map("topic_group") // messages | tasks | events | all
  applySeq   BigInt   @default(0) @map("apply_seq")
  readSeq    BigInt   @default(0) @map("read_seq")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, deviceId, scopeType, scopeId, topicGroup])
  @@index([userId, deviceId])
  @@map("control_client_cursors")
}

/// Reminder — Slock (S4.1). A scheduled nudge anchored to a channel surface.
/// Plain FK columns (no Prisma relation fields), consistent with ControlMessage.senderId
/// and other control-plane self-references. DB-level FKs live in the migration SQL.
/// cadence null = one-shot; status: scheduled | fired | snoozed | canceled | done.
model ControlReminder {
  id              String    @id @default(uuid()) @db.Uuid
  workroomId      String    @map("workroom_id") @db.Uuid
  agentId         String    @map("agent_id") @db.Uuid // author
  channelId       String    @map("channel_id") @db.Uuid // anchor surface
  anchorMessageId String?   @map("anchor_message_id") @db.Uuid
  title           String
  fireAt          DateTime  @map("fire_at")
  cadence         String? // null = one-shot
  status          String    @default("scheduled")
  version         Int       @default(1)
  snoozedUntil    DateTime? @map("snoozed_until")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([agentId, status])
  @@index([workroomId])
  @@map("control_reminders")
}

/// Reminder event log — audit trail of reminder lifecycle transitions (created | fired | snoozed | ...).
/// Cascades when the parent reminder is deleted.
model ControlReminderEvent {
  id         String   @id @default(uuid()) @db.Uuid
  reminderId String   @map("reminder_id") @db.Uuid
  kind       String
  at         DateTime @default(now())
  detail     Json?

  @@index([reminderId])
  @@map("control_reminder_events")
}

/// Prepared action — Slock (S4.2). An agent-proposed control action rendered as a
/// card on a channel surface; a human operator fulfills or dismisses it.
/// Plain FK columns (no Prisma relation fields), consistent with ControlReminder.
/// DB-level FKs (workroom/channel/proposer) live in the migration SQL.
/// type: channel:create | channel:add_member. status: proposed | fulfilled | dismissed.
/// fulfilledByOperator is TEXT (operator subject ids look like `pairing:<uuid>`, not a bare uuid).
/// cardMessageId / fulfilledResultId are soft refs (may dangle) — no FK.
model ControlPreparedAction {
  id                  String   @id @default(uuid()) @db.Uuid
  workroomId          String   @map("workroom_id") @db.Uuid
  channelId           String   @map("channel_id") @db.Uuid // the card surface
  proposerAgentId     String   @map("proposer_agent_id") @db.Uuid // FK→ControlAgent
  type                String // channel:create | channel:add_member
  params              Json
  status              String   @default("proposed") // proposed | fulfilled | dismissed
  cardMessageId       String?  @map("card_message_id") @db.Uuid
  fulfilledByOperator String?  @map("fulfilled_by_operator") // TEXT — operator subject ids look like `pairing:<uuid>`
  fulfilledResultId   String?  @map("fulfilled_result_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([workroomId, status])
  @@index([proposerAgentId])
  @@map("control_prepared_actions")
}

/// Message reaction — Slock (S4.3). A user or agent reacting with an emoji to a control message.
/// Plain FK columns (no Prisma relation fields), consistent with ControlReminder / ControlPreparedAction.
/// DB-level FKs (message/workroom) live in the migration SQL.
/// reactorKind: user | agent. reactorId is a soft ref (no FK — can be a user OR agent id).
model ControlMessageReaction {
  id          String   @id @default(uuid()) @db.Uuid
  messageId   String   @map("message_id") @db.Uuid
  workroomId  String   @map("workroom_id") @db.Uuid
  reactorKind String   @map("reactor_kind") // user | agent
  reactorId   String   @map("reactor_id") @db.Uuid
  emoji       String
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([messageId, reactorId, emoji])
  @@index([messageId])
  @@map("control_message_reactions")
}
